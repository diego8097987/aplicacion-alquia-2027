# Configuración de Firebase para Mueblería Alquia (Proyecto: muebleria-alquia)
# Copia este archivo como .env en tu equipo local y configura las mismas variables en Vercel.
# NUNCA subas tu archivo .env al repositorio privado de GitHub.

VITE_FIREBASE_API_KEY="TU_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="muebleria-alquia.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="muebleria-alquia"
VITE_FIREBASE_STORAGE_BUCKET="muebleria-alquia.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="TU_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="TU_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="TU_MEASUREMENT_ID"
VITE_FIREBASE_DATABASE_ID="ai-studio-3cf56a35-4bde-4d65-85b0-f64b3dc2cbe9"
