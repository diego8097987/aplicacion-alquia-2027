      "description": "Entradas de compra a proveedores vinculadas al inventario de sucursal.",
      "type": "object",
      "properties": {
        "folio": { "type": "string", "minLength": 3, "maxLength": 32 },
        "proveedorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "proveedorNombre": { "type": "string", "minLength": 2, "maxLength": 120 },
        "sucursalId": { "type": "string", "maxLength": 128 },
        "items": { "type": "array" },
        "totalCosto": { "type": "number" },
        "notas": { "type": "string", "maxLength": 240 },
        "registradoPorUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "registradoPorNombre": { "type": "string", "maxLength": 100 },
        "tiendaId": { "type": "string", "pattern": "^alquia-apaseo$" },
        "creadoEn": { "type": "string", "format": "date-time" }
      },
      "required": [
        "folio",
        "proveedorId",
        "proveedorNombre",
        "items",
        "totalCosto",
        "registradoPorUid",
        "creadoEn",
        "tiendaId"
      ]
    }
  },
  "firestore": {
    "/configuracion/{docId}": {
      "schema": { "$ref": "#/entities/Configuracion" },
      "description": "Configuración general de tienda, plantilla de alertas automáticas y consecutivos de folios."
    },
    "/usuarios/{userId}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Usuarios registrados con su cargo asignado por el Admin (admin o cobrador) y su sucursal asignada."
    },
    "/sucursales/{sucursalId}": {
      "schema": { "$ref": "#/entities/Sucursal" },
      "description": "Tiendas/sucursales con dirección exclusiva para tickets y encargado de tienda asignado por el Admin."
    },
    "/inventario_sucursales/{invId}": {
      "schema": { "$ref": "#/entities/InventarioSucursal" },
      "description": "Base de datos privada de existencias de inventario por tienda/sucursal (estrictamente aislada por tienda)."
    },
    "/cajas_turnos/{turnoId}": {
      "schema": { "$ref": "#/entities/CajaTurno" },
      "description": "Turnos de apertura y cierre de caja privados por personal; visibles en auditoría para administradores."
    },
    "/clientes/{clienteId}": {
      "schema": { "$ref": "#/entities/Cliente" },
      "description": "Clientes de la tienda."
    },
    "/proveedores/{proveedorId}": {
      "schema": { "$ref": "#/entities/Proveedor" },
      "description": "Proveedores y fabricantes."
    },
    "/productos/{productoId}": {
      "schema": { "$ref": "#/entities/Producto" },
      "description": "Catálogo de productos (todos los usuarios activos pueden agregar; solo Admin puede editar o eliminar)."
    },
    "/ventas/{ventaId}": {
      "schema": { "$ref": "#/entities/Venta" },
      "description": "Ventas del día (se depuran al cerrar caja tras descargar el PDF diario)."
    },
    "/creditos/{creditoId}": {
      "schema": { "$ref": "#/entities/Credito" },
      "description": "Cartera de créditos (solo Admin puede eliminar cuentas o aumentar pagos atrasados)."
    },
    "/apartados/{apartadoId}": {
      "schema": { "$ref": "#/entities/Apartado" },
      "description": "Apartados vigentes y liquidados."
    },
    "/abonos/{abonoId}": {
      "schema": { "$ref": "#/entities/Abono" },
      "description": "Abonos inmutables de créditos y apartados."
    },
    "/alertas_vencimiento/{alertaId}": {
      "schema": { "$ref": "#/entities/AlertaVencimiento" },
      "description": "Registro deduplicado de alertas automáticas y manuales de pagos vencidos y próximos a vencer."
    },
    "/movimientos_inventario/{movId}": {
      "schema": { "$ref": "#/entities/MovimientoInventario" },
      "description": "Kardex de movimientos aislado por sucursal (solo Admin puede eliminar registros)."
    },
    "/compras_proveedores/{compraId}": {
      "schema": { "$ref": "#/entities/CompraProveedor" },
      "description": "Historial de compras a proveedores."
    }
  }
}
